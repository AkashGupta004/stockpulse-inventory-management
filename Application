#    - Dashboard:     http://127.0.0.1:8000/
#    - Products:      http://127.0.0.1:8000/products/
#    - Add Product:   http://127.0.0.1:8000/products/add/
#    - Categories:    http://127.0.0.1:8000/categories/
#    - Django Admin:  http://127.0.0.1:8000/admin/
